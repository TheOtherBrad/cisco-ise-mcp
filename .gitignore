# Secrets & local config — NEVER commit these
.env
.env.*
!.env.example
deployments.json
# Audit logs (if CISCO_ISE_MCP_HOME points inside the checkout) — may hold
# usernames/MACs/IPs from tool arguments; never commit.
audit.log
logs/
*.log
# Credential exports and key material
*.key
*.p12
*.pfx
*.jks
*.crt
*.cer
*.der
*.pem
*.sso
wallet/
certs/

# Downloaded API specs (reproducible from iseapi_yaml/links.yaml via
# `uv run python scripts/refresh_catalog.py`; the built catalogs under
# src/cisco_ise_mcp/catalog/*.json are the committed artifact). Keep links.yaml.
iseapi_yaml/ers/*.yaml
iseapi_yaml/openapi/*.yaml
iseapi_yaml/monitoring/*.yaml

