# Cisco ISE MCP Server — Environment Configuration (ADVANCED / OPTIONAL)
# ────────────────────────────────────────────────────────────────────────────
# You normally do NOT need this file. The server is READ-ONLY by default and keeps a
# daily audit log; deployments live in a registry (deployments.json) that you manage
# with the CLI:
#
#     cisco-ise-mcp add --name "RADIUS Only" --host 10.1.1.1 --ers-username ers-admin
#     cisco-ise-mcp set-credential radius-only          # stores password in the OS keyring
#
# WHERE THIS FILE MUST LIVE — copy it to a file named ".env" in the CONFIG HOME:
#   macOS    ~/Library/Application Support/cisco-ise-mcp/.env
#   Linux    $XDG_CONFIG_HOME/cisco-ise-mcp/.env   (usually ~/.config/cisco-ise-mcp/.env)
#   Windows  %APPDATA%\cisco-ise-mcp\.env
#   or       $CISCO_ISE_MCP_HOME/.env if you relocated the config home.
# A .env in the project folder or the current directory is IGNORED (by design).
# Keep it private:  chmod 600 <that path>/.env   (macOS/Linux). Never commit it.
#
# Precedence: variables already set by the MCP client "env" block / shell WIN over
# this file; this file wins over built-in defaults. Restart the MCP client after editing.
# Full reference (every variable, values, defaults): docs/USER_GUIDE.md section 10.

# ── Config home location ──
# CISCO_ISE_MCP_HOME CANNOT be set in this file (it decides where this file is).
# Set it in the MCP client "env" block or the shell instead, e.g.
#   CISCO_ISE_MCP_HOME=/opt/cisco-ise-mcp

# ── Per-deployment password injection (headless / container alternative to keyring) ──
# The variable name is built from the deployment SLUG (lower-case name, spaces -> hyphens,
# then hyphens -> underscores, upper-cased). Examples for the sample deployments:
#
#   "RADIUS Only" -> slug radius-only -> RADIUS_ONLY
#   "TACACS Only" -> slug tacacs-only -> TACACS_ONLY
#   "VPN Only"    -> slug vpn-only    -> VPN_ONLY
#
# ERS / Open API password:
# CISCO_ISE__RADIUS_ONLY__ISE_PASSWORD=YourErsPassword
# Data Connect password (only if Data Connect is enabled for that deployment):
# CISCO_ISE__RADIUS_ONLY__DATACONNECT_PASSWORD=YourDataConnectPassword
#
# You may also point at a secret file (Docker/K8s secrets) instead of an inline value:
# CISCO_ISE__RADIUS_ONLY__ISE_PASSWORD_FILE=/run/secrets/radius_only_ise_password
# CISCO_ISE__RADIUS_ONLY__DATACONNECT_PASSWORD_FILE=/run/secrets/radius_only_dc_password

# Resolution order per deployment:  env var  ->  *_FILE  ->  OS keyring.

# ── Resource limits (optional ceilings) ──────────────────────────────────────
# These bound how hard this server may drive an ISE deployment. Cisco documents
# ~100 concurrent ERS and ~150 concurrent Open API connections PER DEPLOYMENT —
# budgets shared with pxGrid, the admin GUI and every other integration — and
# publishes no limits at all for Data Connect. Defaults below are deliberately a
# small slice of those budgets.
#
# These variables are HARD CEILINGS. A per-deployment "limits" block in
# deployments.json may only TIGHTEN them, never raise them — so an AI agent
# (which can edit non-secret registry fields) cannot raise its own budget.
# Run ise_limits_status, or `cisco-ise-mcp test <slug>`, to see what is in force.

# Data Connect — the surface with no Cisco-documented limit.
# CISCO_ISE_MCP_DC_MAX_CONCURRENT=5          # simultaneous queries (also the Oracle pool size)
# CISCO_ISE_MCP_DC_ACQUIRE_WAIT_S=5          # seconds to queue for a slot before refusing (max 15)
# CISCO_ISE_MCP_DC_QUERY_TIMEOUT_S=60        # cancels the query ON the MnT node, not just client-side
# CISCO_ISE_MCP_DC_QPM=30                    # sustained queries per minute
# CISCO_ISE_MCP_DC_DEFAULT_DAYS_BACK=7       # window applied when days_back is omitted
# CISCO_ISE_MCP_DC_MAX_DAYS_BACK=90          # larger requests are reduced to this, not rejected
# CISCO_ISE_MCP_DC_DEFAULT_ROW_LIMIT=500     # row bound injected into ise_dc_query when it has none
# CISCO_ISE_MCP_DC_DEFAULT_AGG_ROW_LIMIT=5000  # ... and when the query aggregates
# CISCO_ISE_MCP_DC_MAX_FACT_VIEWS=3          # large event views joinable at once (lookups are exempt)

# REST surfaces — a fraction of Cisco's documented deployment-wide budgets.
# CISCO_ISE_MCP_ERS_MAX_CONCURRENT=10        # of Cisco's ~100
# CISCO_ISE_MCP_OPENAPI_MAX_CONCURRENT=15    # of Cisco's ~150
# CISCO_ISE_MCP_MNT_MAX_CONCURRENT=5

# ── Access control (read-only by default) ───────────────────────────────────
# Master write switch. Unset/0 = READ-ONLY: no ISE create/update/delete/CoA and no
# deployment add/update/remove by the agent; write-capable tools are NOT LOADED and the
# raw passthroughs accept GET only. 1 = all tools load; destructive calls (delete,
# restore/rollback, patch install, cert import, CoA, session delete) still need
# confirm=true on each call.
# CISCO_ISE_MCP_ALLOW_DESTRUCTIVE=0
# Comma-separated tools that are NEVER loaded and ALWAYS refused (read or write),
# whatever the master switch says — e.g. allow writes but keep these GUI-only:
# CISCO_ISE_MCP_BLOCKED_TOOLS=ise_openapi_backup_restore,ise_openapi_patch_install
# Validate tool arguments against each tool's input schema (default on). 0 = off.
# CISCO_ISE_MCP_VALIDATE_ARGS=1

# ── Audit log & output ──────────────────────────────────────────────────────
# Daily audit logs: <config home>/logs/YYYY-MM-DD.log (owner-only, secrets -> *****).
# Days of logs to keep; default 365, clamped to 90..3650. Set it here or in the MCP
# client env — deliberately NOT in deployments.json (the agent must not shorten it).
# CISCO_ISE_MCP_LOG_RETENTION_DAYS=365
# Also send MCP structuredContent (v2 clients). Off by default: it duplicates the text.
# CISCO_ISE_MCP_STRUCTURED=0
# Return ERS responses verbatim (keep link/nextPage hypermedia). Off by default.
# CISCO_ISE_MCP_RAW_ERS=0
# Server diagnostic log level (stderr; stdout is the MCP stream).
# CISCO_ISE_MCP_LOG_LEVEL=WARNING
# NOTE: HTTP(S)_PROXY / SSL_CERT_FILE are IGNORED for ISE admin connections (trust_env
# is off); trust a private CA with the deployment's ca_cert_path instead.
